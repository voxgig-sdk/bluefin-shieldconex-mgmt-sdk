# BasicPartnerFlow

main: kit: flow: BasicPartnerFlow:
{
  entity: "partner",
  kind: "basic",
  name: "BasicPartnerFlow",
  step: [
    {
      i: {
        ref: "partner_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "partner_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "partner_ref01",
        srcdatavar: "partner_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "partner01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-partner_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPartnerFlow"
}