# BasicClientFlow

main: kit: flow: BasicClientFlow:
{
  entity: "client",
  kind: "basic",
  name: "BasicClientFlow",
  step: [
    {
      i: {
        ref: "client_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "client_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "client_ref01",
        srcdatavar: "client_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "client01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-client_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "client_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "client01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "client_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicClientFlow"
}