              }
            ]
          }
          method: "GET"
          orig: "/transactions/{id}"
          segments: [
            {
              lit: "transactions"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "transaction_type"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
