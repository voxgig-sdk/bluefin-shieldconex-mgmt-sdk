# Entity: transaction

main: kit: entity: transaction: {

  alias: field: {}

  fields: [
    {
      name: "bfid"
      req: false
      short: "BFID"
      type: "`$STRING`"
    }
    {
      name: "client"
      req: false
      short: "Reference to the associated Client resource."
      type: "`$OBJECT`"
    }
    {
      format: "date-time"
      name: "completeDate"
      req: false
      short: "Timestamp from the beginning of the transaction."
      type: "`$STRING`"
    }
    {
      name: "directPartner"
      req: false
      short: "Reference to the associated Partner."
      type: "`$OBJECT`"
    }
    {
      name: "errCode"
      req: false
      short: "The error code that is sent in response to a failed decrypt API call."
      type: "`$STRING`"
    }
    {
      name: "errMessage"
      req: false
      short: "The error messge that is sent in response to a failed decrypt API call."
      type: "`$STRING`"
    }
    {
      format: "int64"
      name: "id"
      req: false
      short: "This resource's unique identifier."
      type: "`$INTEGER`"
    }
    {
      name: "ipAddress"
      req: false
      short: "The IP address of the http client that makes the decrypt API call."
      type: "`$STRING`"
    }
    {
      name: "messageId"
      req: false
      short: "Message ID."
      type: "`$STRING`"
    }
    {
      name: "partner"
      req: false
      short: "Reference to the associated Partner."
      type: "`$OBJECT`"
    }
    {
      name: "reference"
      req: false
      short: "The reference property that the Client includes in the decrypt API call."
      type: "`$STRING`"
    }
    {
      name: "success"
      req: false
      short: "The success indicator."
      type: "`$BOOLEAN`"
    }
    {
      format: "int32"
      name: "templateId"
      req: false
      short: "The Template's unique identifier."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "transaction"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "client"
                orig: "client"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "date_from"
                orig: "date_from"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "date_to"
                orig: "date_to"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "message_id"
                orig: "message_id"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "paging_mode"
                orig: "paging_mode"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "partner"
                orig: "partner"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "reference"
                orig: "reference"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 0
                kind: "query"
                name: "skip"
                orig: "skip"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "success"
                orig: "success"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                example: 10
                kind: "query"
                name: "take"
                orig: "take"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "transaction_type"
                orig: "transaction_type"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/transactions"
          segments: [
            {
              lit: "transactions"
            }
          ]
          select: {
            exist: [
              "client"
              "date_from"
              "date_to"
              "message_id"
              "paging_mode"
              "partner"
              "reference"
              "skip"
              "success"
              "take"
              "transaction_type"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
